;html=1;endArrow=none;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c22" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="Холодильник (кухня)&lt;br&gt;Кондиціонер (зала)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;" vertex="1" parent="1"><mxGeometry x="440" y="680" width="85" height="60" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c40" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="&lt;b&gt;Примітки&lt;/b&gt;&lt;br&gt;• Два джерела: мережа (положення I) та зарядна станція (положення II), перемикаються SA1 — паралельна робота неможлива.&lt;br&gt;• ПЗВ QD1 стоїть лише в колі мережі (до SA1), тому при живленні від станції групи працюють без ПЗВ.&lt;br&gt;• XS1 живиться від мережі (через QF3) — для зарядки станції; точка підключення QF3 (до/після ПЗВ) — уточнити.&lt;br&gt;• N — через сині шини N, PE — через зелену шину PE (на схемі не показані)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;shape=note;size=14;fillColor=#ffffcc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="340" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="layout" name="Розміщення в щиті"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Розміщення апаратів у щиті (вигляд спереду), 1 модуль = 18 мм" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;text;fontSize=16;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fafafa;strokeColor=#666666;strokeWidth=2;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="760" height="640" as="geometry"/></mxCell><mxCell id="c5" value="Шина N" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9cc3e6;strokeColor=#2f5597;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="120" height="40" as="geometry"/></mxCell><mxCell id="c6" value="Шина N" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9cc3e6;strokeColor=#2f5597;" vertex="1" parent="1"><mxGeometry x="185" y="70" width="120" height="40" as="geometry"/></mxCell><mxCell id="c7" value="Клема N" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9cc3e6;strokeColor=#2f5597;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="80" height="40" as="geometry"/></mxCell><mxCell id="c8" value="Шина PE" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#a9d18e;strokeColor=#548235;" vertex="1" parent="1"><mxGeometry x="430" y="70" width="350" height="40" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#bfbfbf;strokeColor=#7f7f7f;" vertex="1" parent="1"><mxGeometry x="60" y="227.0" width="720" height="16" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;QF2&lt;/b&gt;&lt;br&gt;MBN 210&lt;br&gt;B10" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="100" height="150" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;SA1&lt;/b&gt;&lt;br&gt;SFT 225&lt;br&gt;25 A&lt;br&gt;I–0–II" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="160" width="100" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;QF3&lt;/b&gt;&lt;br&