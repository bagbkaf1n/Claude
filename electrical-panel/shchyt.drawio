ll><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c39" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="&lt;b&gt;Примітки&lt;/b&gt;&lt;br&gt;• Апарати і номінали — з фото щита.&lt;br&gt;• Порядок з'єднань &lt;b&gt;припущений&lt;/b&gt; за типовою схемою «мережа + генератор»; перевірте реальне підключення.&lt;br&gt;• Штрихова лінія — найменш певне з'єднання (QF3).&lt;br&gt;• N — через сині шини N, PE — через зелену шину PE (на схемі не показані).&lt;br&gt;• Підписи груп (освітлення, розетки, кухня…) заповніть самі." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;shape=note;size=14;fillColor=#ffffcc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="340" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="layout" name="Розміщення в щиті"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Розміщення апаратів у щиті (вигляд спереду), 1 модуль = 18 мм" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;text;fontSize=16;fontStyle=1;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fafafa;strokeColor=#666666;strokeWidth=2;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="760" height="640" as="geometry"/></mxCell><mxCell id="c5" value="Шина N" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9cc3e6;strokeColor=#2f5597;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="120" height="4